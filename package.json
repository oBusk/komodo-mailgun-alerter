{
  "name": "komodo-mailgun-alerter",
  "private": true,
  "license": "MIT",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "bun",
      "version": "1.4.1",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "^7"
  },
  "dependencies": {
    "komodo_client": "^2.3.2",
    "mailgun.js": "^14.0.0"
  }
}
